# Integrated Healthcare Platform - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# === REQUIRED ===

# Google Gemini API Key - Get yours free at https://aistudio.google.com/app/apikey
# Used for all LLM operations: diagnosis, prescription verification, records, research
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL - Paths ===

# ChromaDB persistent storage path (default: ./data/chroma_db)
CHROMA_DB_PATH=./data/chroma_db

# Audit database path (default: ./data/audit.db)
AUDIT_DB_PATH=./data/audit.db

# Logs directory (default: ./logs)
LOG_DIR=./logs

# === OPTIONAL - Model Configuration ===

# Primary LLM model (default: gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# Lite model for simple/cache-hit tasks (default: gemini-2.0-flash-lite)
LLM_LITE_MODEL=gemini-2.0-flash-lite

# Embedding model (default: models/text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004

# === OPTIONAL - System Settings ===

# Cache TTL in seconds for LLM responses (default: 300 = 5 min)
CACHE_TTL_SECONDS=300

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Enable verbose debug output (default: false)
DEBUG=false
